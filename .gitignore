# Generated Python files
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Original PDFs and host-specific existing runtime
/data/pdf/*
!/data/pdf/.gitkeep
/utility/.runtime/

# Execution results, raw responses, archives and temporary migration state
/res/*
!/res/README.md

# Explicitly published review pilot; keep other run outputs private
!/res/published/
/res/published/*
!/res/published/review_exp_iclr2026_pilot/

# Private/local runtime overrides
*.pid
*.lock
.DS_Store
